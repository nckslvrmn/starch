#!/bin/bash

# way-displays handles display hotplug live (arrange, DPI scale, VRR, lid) so
# plugging in HDMI moves the desktop with no reboot. Config: ~/.config/way-displays/cfg.yaml.
_start_display_daemon() {
    if command -v way-displays >/dev/null 2>&1; then
        echo "[river/init] starting way-displays (reactive display hotplug)"
        way-displays >"${XDG_STATE_HOME:-$HOME/.local/state}/way-displays.log" 2>&1 &
    elif command -v wlr-randr >/dev/null 2>&1; then
        # Fallback if the daemon is missing: one-shot, no hotplug.
        echo "[river/init] way-displays not found — one-shot wlr-randr fallback"
        local primary="${STARCH_PRIMARY_OUTPUT:-}"
        [ -n "$primary" ] && wlr-randr --output "$primary" --on 2>/dev/null || true
    else
        echo "[river/init] no display manager (way-displays/wlr-randr) found — leaving outputs as-is"
    fi
}

systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DISPLAY
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DISPLAY
systemctl --user restart xdg-desktop-portal

_start_display_daemon

riverctl map normal Alt Shift Tab focus-prev
riverctl map normal Alt Tab       focus-next
riverctl map normal Alt Tab       zoom
riverctl map normal Super Space   spawn fuzzel
riverctl map normal Super+Shift E exit

riverctl map normal Super Left  send-layout-cmd riversnap "left"
riverctl map normal Super Right send-layout-cmd riversnap "right"
riverctl map normal Super Up    send-layout-cmd riversnap "full"

riverctl map normal None XF86AudioRaiseVolume  spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+'
riverctl map normal None XF86AudioLowerVolume  spawn 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-'
riverctl map normal None XF86AudioMute         spawn 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'

riverctl map normal None XF86MonBrightnessUp   spawn 'brightnessctl set 5%+'
riverctl map normal None XF86MonBrightnessDown spawn 'brightnessctl set 5%-'

riverctl background-color 0x000000

riversnap &
riverctl default-layout riversnap

/usr/bin/ghostty &
