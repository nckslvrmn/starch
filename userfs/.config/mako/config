# starch notifications (mako). Matches the black fuzzel launcher.
#
# Used both for app notifications and as the OSD for volume/brightness/battery
# (see starch-osd, wired to the media keys + Super+B in river/init). Those send
# a `value` hint, which mako renders as a progress bar via progress-color.

font=monospace 16
background-color=#000000ee
text-color=#ffffffff
border-color=#222222ff
border-size=1
border-radius=0
# Progress bar drawn over the background for the OSD value hint — kept a muted
# dark shade so a partial fill reads as a faint gauge, not a hard blue/black split.
progress-color=over #16243aff

anchor=top-right
margin=10
padding=16
width=480
default-timeout=4000

[urgency=low]
default-timeout=2000
