# starch notifications (mako). Matches the black fuzzel launcher.
#
# Backs both app notifications and the volume/brightness/battery OSD (starch-osd,
# wired to the media keys and Super+B in canoe). Those send a `value` hint, which
# mako renders as a progress bar via progress-color.

font=monospace 16
background-color=#000000ee
text-color=#ffffffff
border-color=#222222ff
border-size=1
border-radius=0
# Drawn over the background for the OSD value hint. Muted dark, so a partial fill
# reads as a faint gauge instead of a hard blue/black split.
progress-color=over #16243aff

anchor=top-right
margin=10
padding=16
width=480
default-timeout=4000

[urgency=low]
default-timeout=2000
