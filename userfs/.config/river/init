#!/bin/bash
# river runs this as a process group leader once the Wayland server is up but
# before the main loop. It's a startup script only: river has no window
# management of its own, so layout, focus, decorations, snapping and every
# keybinding belong to canoe, started at the bottom of this file and configured
# in ~/.config/canoe/canoe.toml.

# way-displays handles hotplug live (arrange, DPI scale, VRR, lid), so plugging
# in HDMI moves the desktop with no reboot. See ~/.config/way-displays/cfg.yaml.
_start_display_daemon() {
    if command -v way-displays >/dev/null 2>&1; then
        echo "[river/init] starting way-displays (reactive display hotplug)"
        way-displays >"${XDG_STATE_HOME:-$HOME/.local/state}/way-displays.log" 2>&1 &
    elif command -v wlr-randr >/dev/null 2>&1; then
        # No daemon, so this is one-shot with no hotplug.
        echo "[river/init] way-displays not found — one-shot wlr-randr fallback"
        local primary="${STARCH_PRIMARY_OUTPUT:-}"
        [ -n "$primary" ] && wlr-randr --output "$primary" --on 2>/dev/null || true
    else
        echo "[river/init] no display manager (way-displays/wlr-randr) found — leaving outputs as-is"
    fi
}

# Enlarge text without scaling the whole surface, so it stays crisp at 100%
# output scale. 120 = 96 DPI * 1.25. GTK, Qt and XWayland each need their own.
# Tune these together to resize text, not the output scale.
export GDK_DPI_SCALE=1.25
export QT_FONT_DPI=120
echo 'Xft.dpi: 120' | xrdb -merge 2>/dev/null || true

systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DISPLAY
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DISPLAY
systemctl --user restart xdg-desktop-portal

_start_display_daemon

# The window manager. river shows nothing at all without one: no windows, no
# keybindings, no way back out except a TTY. So anything that leaves us without
# canoe ends the session instead of parking on a black screen. Keyboard repeat
# (50/300) is canoe's built-in default, so there's nothing to set here.
#
# Restarting the window manager doesn't disturb the compositor or the running
# apps, so a crash is recoverable in place. The loop is bounded because a canoe
# that dies instantly would otherwise spin forever. It makes no noise at
# shutdown: river SIGTERMs the whole init process group on the way out, taking
# the supervisor with it.
_supervise_wm() {
    local tries=0
    while [ "$tries" -lt 5 ]; do
        canoe
        tries=$((tries + 1))
        echo "[river/init] canoe exited — restarting ($tries/5)"
        sleep 1
    done
    echo "[river/init] canoe will not stay up — ending the session"
    pkill -x river
}

if command -v canoe >/dev/null 2>&1; then
    _supervise_wm &
else
    echo "[river/init] canoe not found — river 0.4 has no window management without it"
    echo "[river/init] install it with 'paru -S canoe' (or re-run install.sh), then log in again"
    pkill -x river
fi

# Notification daemon, behind both app notifications and the
# volume/brightness/battery OSD (starch-osd).
command -v mako >/dev/null 2>&1 && mako &

# Lock after 10 idle minutes and before suspend (lid close means logind suspend,
# which NVreg_PreserveVideoMemoryAllocations and the nvidia units make safe).
# The timeout goes through starch-lock-if-idle because Brave and Chromium can't
# inhibit idle on wlroots, so playing audio defers the lock instead. before-sleep
# locks unconditionally but must not stack a second instance on an existing lock,
# and -e ignores empty-password submits so waking with Enter can't feed
# pam_faillock.
if command -v swayidle >/dev/null 2>&1 && command -v swaylock >/dev/null 2>&1; then
    swayidle -w \
        timeout 600 'starch-lock-if-idle' \
        before-sleep 'pgrep -x swaylock || swaylock -f -e -c 000000' &
fi

# canoe may not have connected yet, which is fine: river holds unmanaged windows
# and hands the whole set over when the window manager attaches.
starch-terminal &
