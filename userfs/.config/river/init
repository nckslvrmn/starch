#!/bin/bash
# river 0.4 runs this as a process group leader once the Wayland server is up
# but before the main loop. Unlike 0.3 it is a startup script only: river has no
# window management of its own and the 0.3 control CLI is gone — do not name it
# here, river greps this file for that string and refuses to start if it finds
# it, on the assumption the migration was never finished. Layout, focus,
# decorations, snapping and every keybinding belong to canoe, the window manager
# started at the bottom of this file — see ~/.config/canoe/canoe.toml.

# way-displays handles display hotplug live (arrange, DPI scale, VRR, lid) so
# plugging in HDMI moves the desktop with no reboot. Config: ~/.config/way-displays/cfg.yaml.
_start_display_daemon() {
    if command -v way-displays >/dev/null 2>&1; then
        echo "[river/init] starting way-displays (reactive display hotplug)"
        way-displays >"${XDG_STATE_HOME:-$HOME/.local/state}/way-displays.log" 2>&1 &
    elif command -v wlr-randr >/dev/null 2>&1; then
        # Fallback if the daemon is missing: one-shot, no hotplug.
        echo "[river/init] way-displays not found — one-shot wlr-randr fallback"
        local primary="${STARCH_PRIMARY_OUTPUT:-}"
        [ -n "$primary" ] && wlr-randr --output "$primary" --on 2>/dev/null || true
    else
        echo "[river/init] no display manager (way-displays/wlr-randr) found — leaving outputs as-is"
    fi
}

# Enlarge text without scaling the whole surface (stays crisp at 100% output
# scale). 120 = 96 DPI * 1.25. GDK_DPI_SCALE for GTK, QT_FONT_DPI for Qt,
# Xft.dpi for XWayland apps. Tune these together to resize, not the output scale.
export GDK_DPI_SCALE=1.25
export QT_FONT_DPI=120
echo 'Xft.dpi: 120' | xrdb -merge 2>/dev/null || true

systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DISPLAY
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DISPLAY
systemctl --user restart xdg-desktop-portal

_start_display_daemon

# The window manager. river 0.4 shows nothing at all without one — no windows,
# no keybindings, no way back out except a TTY — so anything that leaves us
# without canoe ends the session instead of parking on a black screen.
# Keyboard repeat (50/300, the rate this desktop has always used) is canoe's
# built-in default, so there is nothing to set here.
#
# Restarting the window manager does not disturb the compositor or the running
# apps (that is the point of the 0.4 split), so a crash is recoverable in place.
# The loop is bounded: a canoe that dies instantly would otherwise spin forever.
# No shutdown noise from this — river SIGTERMs the whole init process group when
# it exits, taking the supervisor with it.
_supervise_wm() {
    local tries=0
    while [ "$tries" -lt 5 ]; do
        canoe
        tries=$((tries + 1))
        echo "[river/init] canoe exited — restarting ($tries/5)"
        sleep 1
    done
    echo "[river/init] canoe will not stay up — ending the session"
    pkill -x river
}

if command -v canoe >/dev/null 2>&1; then
    _supervise_wm &
else
    echo "[river/init] canoe not found — river 0.4 has no window management without it"
    echo "[river/init] install it with 'paru -S canoe' (or re-run install.sh), then log in again"
    pkill -x river
fi

# Notification daemon — backs app notifications and the volume/brightness/
# battery OSD (starch-osd). command -v guards a missing install.
command -v mako >/dev/null 2>&1 && mako &

# Lock after 10 idle minutes and before suspend (lid close → logind suspend;
# NVreg_PreserveVideoMemoryAllocations + the nvidia units make that safe).
# The timeout goes through starch-lock-if-idle: Brave/Chromium can't inhibit
# idle on wlroots, so playing audio (movie, music) defers the lock instead.
# before-sleep locks unconditionally (no audio gate) but must not stack a
# second instance over an existing lock; -e ignores empty-password submits so
# waking the screen with Enter can't feed pam_faillock.
if command -v swayidle >/dev/null 2>&1 && command -v swaylock >/dev/null 2>&1; then
    swayidle -w \
        timeout 600 'starch-lock-if-idle' \
        before-sleep 'pgrep -x swaylock || swaylock -f -e -c 000000' &
fi

# Started before canoe has necessarily connected — river holds unmanaged windows
# and hands the whole set to the window manager when it attaches, so the
# ordering is safe.
starch-terminal &
