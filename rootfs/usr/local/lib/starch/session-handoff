#!/bin/bash
# Root-side consumer of session-switch requests, driven by the
# starch-session-handoff.path unit watching the request file.
#
# Steam's client runs inside a pressure-vessel container that is PID-namespaced
# (host processes are invisible, so pgrep/pkill and waiting on gamescope can't
# work) and nosuid (sudo and pkexec fail). The filesystem is the only reliable
# channel out, so steamos-session-select writes a request file in $HOME and this
# helper does the real work on the host: write a one-shot SDDM autologin
# drop-in, tear the session down, restart SDDM so autologin fires. Same
# mechanism SteamOS itself uses.
set -uo pipefail

REQ="@@GAMING_HOME@@/.local/state/starch/session-request"
CONF=/etc/sddm.conf.d/zz-starch-autologin.conf
BOOT_CONF=/etc/sddm.conf.d/20-starch-boot.conf

log() { echo "starch-session-handoff: $*"; }

[ -e "$REQ" ] || exit 0

# The file is user-writable and this runs as root, so refuse symlinks and
# anything the gaming user doesn't own.
if [ -L "$REQ" ] || [ ! -f "$REQ" ] \
   || [ "$(stat -c %U "$REQ" 2>/dev/null)" != "@@GAMING_USER@@" ]; then
    log "refusing request file (symlink or wrong owner)"
    rm -f "$REQ"
    exit 1
fi

target=$(head -c 64 "$REQ" | tr -cd 'a-z-')
rm -f "$REQ"

case "$target" in
    desktop|river)
        session=starch-river.desktop ;;
    steam)
        session=steam.desktop ;;
    clear)
        # Sessions request this on start so the greeter is back to normal
        # afterwards. No SDDM restart needed.
        rm -f "$CONF"
        log "cleared one-shot autologin"
        exit 0 ;;
    boot-steam)
        # Console mode (starch-select-boot): every boot goes straight into
        # Steam. The one-shot conf (zz-) sorts later, so a single switch still
        # wins and then falls back to this.
        cat > "$BOOT_CONF" <<EOF
# Persistent boot-to-Steam, managed by starch-select-boot {steam|greeter}.
[Autologin]
User=@@GAMING_USER@@
Session=steam.desktop
EOF
        log "boot mode set to steam ($BOOT_CONF)"
        exit 0 ;;
    boot-greeter)
        rm -f "$BOOT_CONF"
        log "boot mode set to greeter"
        exit 0 ;;
    reboot)
        log "reboot requested"
        systemctl reboot
        exit 0 ;;
    *)
        log "unknown target '$target' — ignoring"
        exit 1 ;;
esac

log "handoff to $session requested"

cat > "$CONF" <<EOF
# One-shot autologin written by starch-session-handoff. The next session
# start requests 'clear', which removes it. If you're reading this and you
# didn't just switch sessions, it's stale. Delete it to get the greeter back.
[Autologin]
User=@@GAMING_USER@@
Session=$session
EOF

# Ask Steam to exit through its own IPC first (works from root on behalf of the
# user), then give the compositor 10s to unwind. gamescope --steam exits when
# Steam does, and SIGTERMing gamescope first just hangs.
if pgrep -u "@@GAMING_USER@@" -x steam >/dev/null 2>&1; then
    runuser -u "@@GAMING_USER@@" -- /usr/bin/steam -shutdown >/dev/null 2>&1 || true
fi
for _ in $(seq 1 100); do
    pgrep -x gamescope >/dev/null 2>&1 || pgrep -x river >/dev/null 2>&1 || break
    sleep 0.1
done

# Only if something survived. SIGKILL mid-DRM-handoff can wedge the GPU, and the
# SDDM restart below recovers the display either way.
if pgrep -x gamescope >/dev/null 2>&1; then
    log "graceful shutdown timed out — killing gamescope/steam"
    pkill -KILL -x gamescope 2>/dev/null || true
    pkill -KILL -x steam 2>/dev/null || true
    sleep 1
fi

# Required even after a clean exit. SDDM only evaluates [Autologin] when the
# daemon starts, not when a session ends.
log "restarting sddm for autologin into $session"
systemctl restart sddm.service
