#!/bin/bash
# Root-side update probe, run by starch-update-check.timer. Writes the pending
# update list where Steam's containerized steamos-update can read it, and $HOME
# is the only path proven visible inside the client container. Gated on
# STARCH_STEAM_UPDATES in /etc/starch/profile.conf: when it's off the file isn't
# there and steamos-update always reports "no updates" (exit 7).
set -uo pipefail

STATE_DIR="@@GAMING_HOME@@/.local/state/starch"
AVAIL="$STATE_DIR/updates-available"

enabled=0
if [ -r /etc/starch/profile.conf ]; then
    enabled=$(. /etc/starch/profile.conf 2>/dev/null; echo "${STARCH_STEAM_UPDATES:-0}")
fi

if [ "$enabled" != "1" ]; then
    rm -f "$AVAIL"
    exit 0
fi

command -v checkupdates >/dev/null 2>&1 || exit 0

mkdir -p "$STATE_DIR"
updates=$(checkupdates 2>/dev/null || true)

if [ -n "$updates" ]; then
    printf '%s\n' "$updates" > "$AVAIL.tmp"
    chown "@@GAMING_USER@@:" "$AVAIL.tmp" 2>/dev/null || true
    mv "$AVAIL.tmp" "$AVAIL"
    echo "starch-update-check: $(wc -l <<<"$updates") update(s) pending"
else
    rm -f "$AVAIL"
    echo "starch-update-check: up to date"
fi
