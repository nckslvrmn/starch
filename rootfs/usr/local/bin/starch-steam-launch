#!/bin/bash
# Run a command in a bubblewrap namespace where /etc/os-release reports SteamOS.
# gamepadui gates "Switch to Desktop" and the power-menu actions on that marker,
# so without it they're silent no-ops.
set -eu

SPOOF=/etc/starch/os-release.steamos
if [ ! -r "$SPOOF" ]; then
    echo "starch-steam-launch: $SPOOF missing — re-run install.sh" >&2
    exec "$@"
fi

if ! command -v bwrap >/dev/null 2>&1; then
    echo "starch-steam-launch: bwrap not installed — re-run install.sh" >&2
    exec "$@"
fi

# On Arch /etc/os-release is a symlink to /usr/lib/os-release, so bind the target
# and anything resolving the symlink sees the spoof too.
exec bwrap \
    --dev-bind / / \
    --bind "$SPOOF" /usr/lib/os-release \
    -- "$@"
