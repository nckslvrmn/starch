#!/bin/bash
# Update the system with the rolling-release guardrails attached: run the
# upgrade, then check for the two states that break the next gaming session
# (kernel upgraded under a running kernel, NVIDIA userspace/module drift)
# and say REBOOT loudly if either holds.
set -uo pipefail

if [ "${1:-}" = "--check" ] || [ "${1:-}" = "-c" ]; then
    if command -v checkupdates >/dev/null 2>&1; then
        checkupdates || echo "no repo updates pending"
    else
        echo "checkupdates not found — install pacman-contrib (re-run install.sh)" >&2
        exit 1
    fi
    exit 0
fi

paru -Syu
rc=$?

needs_reboot=0
if pacman -Q linux &>/dev/null; then
    running=$(uname -r | sed 's/-/./')
    installed=$(pacman -Q linux | awk '{print $2}')
    [ "$running" != "$installed" ] && needs_reboot=1
fi
if [ -r /sys/module/nvidia/version ]; then
    mod=$(cat /sys/module/nvidia/version)
    pkg=$(pacman -Q nvidia-utils 2>/dev/null | awk '{print $2}' | cut -d- -f1)
    [ -n "$pkg" ] && [ "$mod" != "$pkg" ] && needs_reboot=1
fi

if [ "$needs_reboot" -eq 1 ]; then
    printf '\033[1;33m[starch] Kernel or NVIDIA driver changed — REBOOT before starting a session.\033[0m\n'
fi

exit "$rc"
