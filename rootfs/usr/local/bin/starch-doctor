#!/bin/bash
# Preflight everything that can break a session. Safe to run from a TTY.
set -u

PASS=0
FAIL=0
WARN=0

green()  { printf '\e[32m%s\e[0m' "$*"; }
red()    { printf '\e[31m%s\e[0m' "$*"; }
yellow() { printf '\e[33m%s\e[0m' "$*"; }

check() {
    local name="$1" status="$2" detail="${3:-}"
    case "$status" in
        pass) printf '  [%s] %s\n' "$(green ' OK ')"   "$name"; PASS=$((PASS+1)) ;;
        fail) printf '  [%s] %s\n' "$(red 'FAIL')"     "$name"; FAIL=$((FAIL+1)) ;;
        warn) printf '  [%s] %s\n' "$(yellow 'WARN')"  "$name"; WARN=$((WARN+1)) ;;
    esac
    [ -n "$detail" ] && printf '         %s\n' "$detail"
}

section() { printf '\n\e[1m=== %s ===\e[0m\n' "$1"; }

section "Config"

if [ -r /etc/starch/profile.conf ]; then
    check "/etc/starch/profile.conf readable" pass "$(tr '\n' ' ' < /etc/starch/profile.conf)"
else
    check "/etc/starch/profile.conf readable" warn "missing — re-run install.sh (refresh fallback unset)"
fi

section "Kernel & boot"

if grep -Eq 'nvidia[-_]drm\.modeset=1' /proc/cmdline 2>/dev/null; then
    check "nvidia_drm.modeset=1 in cmdline" pass
else
    check "nvidia_drm.modeset=1 in cmdline" fail "add to bootloader, or NVIDIA suspend/Wayland will break"
fi

ucode_pkg=""
case "$(awk -F': ' '/^vendor_id/{print $2; exit}' /proc/cpuinfo)" in
    GenuineIntel) ucode_pkg=intel-ucode ;;
    AuthenticAMD) ucode_pkg=amd-ucode ;;
esac
if [ -n "$ucode_pkg" ]; then
    if ! pacman -Q "$ucode_pkg" &>/dev/null; then
        check "CPU microcode" fail "$ucode_pkg not installed"
    elif [ ! -e "/boot/$ucode_pkg.img" ]; then
        check "CPU microcode" fail "/boot/$ucode_pkg.img missing"
    elif grep -qs "$ucode_pkg" /proc/cmdline || \
         grep -rqs "$ucode_pkg" /boot/loader/entries/ /boot/grub/grub.cfg 2>/dev/null; then
        check "CPU microcode" pass "$(awk -F': ' '/^microcode/{print "revision "$2; exit}' /proc/cpuinfo)"
    else
        # Image is there but nothing loads it, so the CPU runs BIOS microcode.
        check "CPU microcode" fail \
            "/boot/$ucode_pkg.img not referenced by any boot entry — add 'initrd /$ucode_pkg.img' BEFORE the main initramfs"
    fi
    grep -qs Vulnerable /sys/devices/system/cpu/vulnerabilities/old_microcode 2>/dev/null && \
        check "microcode up to date" warn "kernel reports old_microcode: Vulnerable"
fi

# Turbo can read as enabled while scaling_max_freq still carries the base-clock
# ceiling, which pins every core to base under load. Check the effective limit.
if [ -r /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq ]; then
    hw=$(cat /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq)
    pol=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq 2>/dev/null || echo 0)
    if [ "$pol" -ge "$hw" ] 2>/dev/null; then
        check "CPU max frequency" pass "$((hw / 1000)) MHz"
    else
        check "CPU max frequency" warn \
            "capped at $((pol / 1000)) MHz of $((hw / 1000)) MHz available"
    fi
fi
if [ -r /sys/devices/system/cpu/intel_pstate/no_turbo ]; then
    if [ "$(cat /sys/devices/system/cpu/intel_pstate/no_turbo)" = "0" ]; then
        check "Intel Turbo Boost" pass
    else
        check "Intel Turbo Boost" warn "disabled (no_turbo=1) — CPU limited to base clock"
    fi
fi

for m in nvidia nvidia_modeset nvidia_drm; do
    if [ -d "/sys/module/$m" ]; then check "module $m loaded" pass
    else check "module $m loaded" fail "modprobe $m failing — check dmesg | grep nvidia"
    fi
done

section "Rolling-release drift"

# Loaded NVIDIA module vs installed userspace. A partial upgrade here means
# GL/Vulkan failures now and probably a black screen next boot.
if [ -r /sys/module/nvidia/version ]; then
    mod_ver=$(cat /sys/module/nvidia/version)
    pkg_ver=$(pacman -Q nvidia-utils 2>/dev/null | awk '{print $2}' | cut -d- -f1)
    if [ -n "$pkg_ver" ]; then
        if [ "$mod_ver" = "$pkg_ver" ]; then
            check "NVIDIA module matches nvidia-utils ($mod_ver)" pass
        else
            check "NVIDIA module ($mod_ver) vs nvidia-utils ($pkg_ver)" fail \
                "version drift — reboot (or fix the partial upgrade) before gaming"
        fi
    fi
fi

# After a kernel upgrade the modules for the running kernel are gone until
# reboot, and sessions fail in confusing ways.
if pacman -Q linux &>/dev/null; then
    running=$(uname -r | sed 's/-/./')
    installed=$(pacman -Q linux | awk '{print $2}')
    if [ "$running" = "$installed" ]; then
        check "running kernel matches installed linux package" pass "$installed"
    else
        check "running kernel ($(uname -r)) vs installed ($installed)" warn \
            "kernel upgraded since boot — REBOOT before starting a session"
    fi
fi

if command -v dkms >/dev/null 2>&1; then
    if dkms status 2>/dev/null | grep -i xpadneo | grep -q "$(uname -r).*installed"; then
        check "xpadneo dkms built for running kernel" pass
    else
        check "xpadneo dkms built for running kernel" warn \
            "dkms status has no xpadneo for $(uname -r) — Xbox BT controllers degraded"
    fi
fi

section "Memory safety"

if swapon --show --noheadings 2>/dev/null | grep -q zram; then
    check "zram swap active" pass
else
    check "zram swap active" warn "no zram — an OOM mid-game is a hard freeze (re-run install.sh)"
fi
if systemctl is-active systemd-oomd.service &>/dev/null; then
    check "systemd-oomd active" pass
else
    check "systemd-oomd active" warn "no userspace OOM killer"
fi

section "Network stack"

for svc in NetworkManager.service iwd.service systemd-resolved.service; do
    if systemctl is-enabled "$svc" &>/dev/null; then check "$svc enabled" pass
    else check "$svc enabled" warn "starch network stack expects this enabled — re-run install.sh"
    fi
done

if grep -qs "^EnableNetworkConfiguration=true" /etc/iwd/main.conf; then
    check "iwd not doing IP config" fail "EnableNetworkConfiguration=true duplicates NM's DHCP"
else
    check "iwd not doing IP config" pass
fi

# An interface NM doesn't manage is invisible in Steam's network panel.
if command -v nmcli >/dev/null 2>&1; then
    unmanaged=$(nmcli -t -f DEVICE,STATE device status 2>/dev/null \
        | awk -F: '$2 == "unmanaged" && $1 != "lo" {printf "%s ", $1}')
    if [ -n "$unmanaged" ]; then
        check "all interfaces NM-managed" warn "unmanaged: ${unmanaged}— invisible to Steam's network UI"
    else
        check "all interfaces NM-managed" pass
    fi
fi

section "DRM devices"

if compgen -G '/dev/dri/card*' >/dev/null; then
    check "/dev/dri/card* present" pass "$(ls /dev/dri/card* 2>/dev/null | tr '\n' ' ')"
else
    check "/dev/dri/card* present" fail "no DRM devices — kernel module not loaded or BIOS GPU mode wrong"
fi

if compgen -G '/sys/class/drm/card*-*/status' >/dev/null; then
    connected=0
    for f in /sys/class/drm/card*-*/status; do
        [ "$(cat "$f" 2>/dev/null)" = "connected" ] && connected=$((connected+1))
    done
    if [ "$connected" -gt 0 ]; then
        check "$connected display(s) connected" pass
    else
        check "displays connected" warn "no connected outputs detected (lid closed? cable unplugged?)"
    fi
fi

section "Backlight (Steam brightness slider)"

if compgen -G '/sys/class/backlight/*' >/dev/null 2>&1; then
    # Same detection the sessions use, so doctor agrees with them.
    BL=""
    if [ -r /usr/local/lib/starch/profile.sh ]; then
        . /usr/local/lib/starch/profile.sh
        BL=$(starch_backlight_device 2>/dev/null || true)
    fi
    if [ -n "$BL" ]; then
        check "backlight device detected" pass "$BL"
        bf="/sys/class/backlight/$BL/brightness"
        if [ -w "$bf" ]; then
            check "$bf writable by session" pass
        else
            owner=$(stat -c '%G' "$bf" 2>/dev/null || echo '?')
            check "$bf writable by session" warn \
                "group=$owner — reboot after install so the udev rule + 'video' group apply; slider needs g+w"
        fi
    else
        check "backlight device detected" warn "no usable /sys/class/backlight device (pure-NVIDIA panels often expose none)"
    fi
else
    check "backlight class present" warn "no /sys/class/backlight — internal-panel brightness control unavailable"
fi

section "Required binaries"

for bin in gamescope steam cage wpctl modetest udevadm sddm wlr-randr checkupdates fwupdmgr; do
    if command -v "$bin" >/dev/null 2>&1; then check "$bin"  pass
    else check "$bin" warn "not in PATH"
    fi
done

# --rt and nice -20 are gated on CAP_SYS_NICE. Without it the session log shows
# "Performance will be affected".
GS_BIN=$(command -v gamescope 2>/dev/null || true)
if [ -n "$GS_BIN" ] && command -v getcap >/dev/null 2>&1; then
    if getcap "$GS_BIN" 2>/dev/null | grep -q cap_sys_nice; then
        check "gamescope has CAP_SYS_NICE (realtime scheduling)" pass
    else
        check "gamescope has CAP_SYS_NICE (realtime scheduling)" fail \
            "setcap cap_sys_nice=eip $GS_BIN — re-run install.sh; --rt is a no-op without it"
    fi
fi

section "Services"

for svc in sddm.service NetworkManager.service; do
    if systemctl is-enabled "$svc" &>/dev/null; then check "$svc enabled" pass
    else check "$svc enabled" fail
    fi
    if systemctl is-active "$svc" &>/dev/null; then check "$svc active" pass
    else check "$svc active" warn
    fi
done

for svc in nvidia-suspend.service nvidia-resume.service nvidia-hibernate.service; do
    if systemctl is-enabled "$svc" &>/dev/null; then check "$svc enabled" pass
    else check "$svc enabled" warn "suspend/resume may corrupt GPU VRAM"
    fi
done

section "Power / battery (Steam gamepadui)"

if command -v upower >/dev/null 2>&1; then
    check "upower installed" pass
    if upower -e 2>/dev/null | grep -q 'battery'; then
        check "battery device present" pass "$(upower -e 2>/dev/null | grep battery | tr '\n' ' ')"
    else
        check "battery device present" warn "no battery enumerated (desktop, or upower not yet activated) — fine on a desktop"
    fi
else
    check "upower installed" warn "not installed — Steam won't show a battery indicator on laptops"
fi

section "Sessions installed"

for s in steam starch-river; do
    if [ -e "/usr/local/share/wayland-sessions/$s.desktop" ]; then check "$s.desktop" pass
    else check "$s.desktop" warn "missing from /usr/local/share/wayland-sessions — re-run install.sh"
    fi
done

# SDDM must scan only the starch session dir, else upstream river.desktop shows
# up in the greeter too.
if grep -rqs '^SessionDir=/usr/local/share/wayland-sessions' /etc/sddm.conf.d/ 2>/dev/null; then
    check "SDDM SessionDir scoped to starch sessions" pass
else
    check "SDDM SessionDir scoped to starch sessions" warn \
        "SessionDir not set — upstream river.desktop may show in the greeter"
fi

for s in start-steam start-river starch-steam-launch steamos-session-select \
         starch-select-display starch-terminal; do
    p=$(command -v "$s" 2>/dev/null || true)
    if [ -n "$p" ] && [ -x "$p" ]; then check "$s executable" pass "$p"
    else check "$s executable" fail "missing or not executable"
    fi
done

# Steam's "Switch to Desktop" invokes `steamos-session-select plasma`. A strict
# case statement here once broke the button silently, so check it takes that.
if command -v steamos-session-select >/dev/null 2>&1; then
    if steamos-session-select --dry-run plasma >/dev/null 2>&1; then
        check "steamos-session-select accepts 'plasma'" pass "(Switch to Desktop wired correctly)"
    else
        check "steamos-session-select accepts 'plasma'" fail \
            "dry-run rejected 'plasma' — Switch to Desktop will be a no-op"
    fi
fi

# Steam's pressure-vessel runtime only searches /usr/bin, so the button does
# nothing unless the script lives there specifically.
if [ -x /usr/bin/steamos-session-select ]; then
    check "steamos-session-select in /usr/bin (Steam-visible)" pass
else
    check "steamos-session-select in /usr/bin (Steam-visible)" fail \
        "Steam's sandbox can't see it elsewhere — Switch to Desktop does nothing"
fi

# The button only writes a request file, since Steam's container is
# PID-namespaced and nosuid. This path unit is what performs the switch.
if systemctl is-enabled starch-session-handoff.path &>/dev/null \
   && systemctl is-active starch-session-handoff.path &>/dev/null; then
    check "starch-session-handoff.path active (performs the switch)" pass
else
    check "starch-session-handoff.path active (performs the switch)" fail \
        "re-run install.sh — without it, Switch to Desktop writes a request nobody reads"
fi

if [ -e /etc/sddm.conf.d/zz-starch-autologin.conf ]; then
    check "no stale one-shot autologin conf" warn \
        "zz-starch-autologin.conf exists — next SDDM start skips the greeter; delete if unexpected"
else
    check "no stale one-shot autologin conf" pass
fi

section "Desktop (river + canoe)"

# No window manager means a session with no windows, no keybindings and no way
# out but a TTY, so both of these are hard fails.
if command -v river >/dev/null 2>&1; then
    check "river installed" pass "$(river -version 2>/dev/null | head -1)"
else
    check "river installed" fail "not installed — re-run install.sh"
fi

if command -v canoe >/dev/null 2>&1; then
    check "canoe installed (the window manager)" pass "$(command -v canoe)"
else
    check "canoe installed (the window manager)" fail \
        "river 0.4 has no window management of its own — 'paru -S canoe'"
fi

# Run as root via sudo, the config still belongs to the desktop user.
_doctor_home="${HOME:-}"
[ "$(id -u)" -eq 0 ] && [ -n "${SUDO_USER:-}" ] && \
    _doctor_home=$(getent passwd "$SUDO_USER" | cut -d: -f6)
river_init="${XDG_CONFIG_HOME:-$_doctor_home/.config}/river/init"
if [ -r "$river_init" ]; then
    check "river/init present" pass "$river_init"
else
    check "river/init present" fail "$river_init missing — re-run install.sh"
fi

canoe_cfg="${XDG_CONFIG_HOME:-$_doctor_home/.config}/canoe/canoe.toml"
if [ -r "$canoe_cfg" ]; then
    check "canoe.toml present" pass "$canoe_cfg"
else
    check "canoe.toml present" warn \
        "$canoe_cfg missing — canoe falls back to its own defaults (no starch-osd media keys)"
fi

# Super+Q goes through the compositor's foreign-toplevel protocol, because
# canoe's own close binding (Super+W) can't be remapped.
if command -v wlrctl >/dev/null 2>&1; then
    check "wlrctl installed (Super+Q close)" pass
else
    check "wlrctl installed (Super+Q close)" warn \
        "not installed — Super+Q does nothing; Super+W still closes windows"
fi

section "Updates & maintenance"

if systemctl is-enabled starch-update-apply.path &>/dev/null; then
    check "starch-update-apply.path enabled (Steam update UI)" pass
else
    check "starch-update-apply.path enabled (Steam update UI)" warn "re-run install.sh"
fi
if systemctl is-enabled starch-update-check.timer &>/dev/null; then
    check "starch-update-check.timer enabled" pass
else
    check "starch-update-check.timer enabled" warn "re-run install.sh"
fi
for tmr in fstrim.timer paccache.timer; do
    if systemctl is-enabled "$tmr" &>/dev/null; then check "$tmr enabled" pass
    else check "$tmr enabled" warn "re-run install.sh"
    fi
done

# ---------------------------------------------------------------------------
printf '\nSummary: %s pass, %s warn, %s fail\n' "$(green "$PASS")" "$(yellow "$WARN")" "$(red "$FAIL")"
[ "$FAIL" -eq 0 ]
