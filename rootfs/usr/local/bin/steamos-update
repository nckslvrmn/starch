#!/bin/bash
# Steam's gamepadui OS-update hook, originally a stub from
# shahnawazshahin/steam-using-gamescope-guide (see README attribution).
#
#   steamos-update check   → exit 0 if updates pending, 7 if none
#   steamos-update         → apply updates, stream "NN%" progress to stdout
#
# Runs INSIDE Steam's PID-namespaced, nosuid client container, so no pacman, no
# sudo and no view of host processes. Everything goes through $HOME files: the
# root-side starch-update-check.timer maintains updates-available, and writing
# update-request triggers starch-update-apply.path, which streams progress back.
# Gated on STARCH_STEAM_UPDATES=1 in /etc/starch/profile.conf. When that's off
# the root side never writes updates-available, so this always exits 7.
set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/starch"
AVAIL="$STATE_DIR/updates-available"
PROG="$STATE_DIR/update-progress"

MODE=apply
for arg in "$@"; do
    case "$arg" in
        check|--check) MODE=check ;;
        --supports-duplicate-detection) ;;  # acknowledged, nothing to do
    esac
done

if [ "$MODE" = "check" ]; then
    if [ -s "$AVAIL" ]; then
        echo "Update available: $(wc -l < "$AVAIL") package(s)"
        exit 0
    fi
    exit 7
fi

[ -s "$AVAIL" ] || exit 7

mkdir -p "$STATE_DIR"
: > "$PROG" 2>/dev/null || true
printf 'apply\n' > "$STATE_DIR/update-request"

# Tail the progress file the root-side runner writes and mirror the lines to
# stdout, where Steam parses the percentages. Give up after 2h, or after 60s if
# nothing starts at all.
deadline=$(( SECONDS + 7200 ))
start_deadline=$(( SECONDS + 60 ))
last=0
rc=1
while [ "$SECONDS" -lt "$deadline" ]; do
    lines=$(wc -l < "$PROG" 2>/dev/null || echo 0)
    if [ "$lines" -gt "$last" ]; then
        while IFS= read -r line; do
            case "$line" in
                DONE\ *) rc="${line#DONE }"; break 2 ;;
                *)       echo "$line" ;;
            esac
        done < <(sed -n "$(( last + 1 )),${lines}p" "$PROG" 2>/dev/null)
        last=$lines
    elif [ "$last" -eq 0 ] && [ "$SECONDS" -gt "$start_deadline" ]; then
        echo "steamos-update: no response from starch-update-apply — is the path unit enabled?" >&2
        exit 1
    fi
    sleep 1
done

exit "${rc:-1}"
