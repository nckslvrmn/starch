#!/bin/bash
# Toggle session-scoped perf tweaks (replaces gamemode, whose X11-only GPU bits
# never worked under gamescope). `on` snapshots the current power profile and
# switches to performance; `off` puts the old profile back.
#
# This used to drive governor, EPP, turbo and NVIDIA persistence directly, and
# branched on AC vs battery. It no longer does: starch-power-watch owns every
# one of those knobs and derives them from the platform profile. Two writers
# meant the FN+Q hotkey could silently undo a running session's preset, and the
# AC branch meant "performance" quietly meant two different things. Now there
# is exactly one path — set the profile, let the watcher apply it.

set -uo pipefail

STATE_DIR=/run/starch
STATE_FILE=$STATE_DIR/perf.state
PP=/sys/firmware/acpi/platform_profile
PROFILE_CONF=/etc/starch/profile.conf

cmd="${1:-}"

# Echo the first requested profile the firmware actually offers.
pick_platform_profile() {
    local choices="" c
    read -r choices < "${PP}_choices" 2>/dev/null || return 1
    for c in "$@"; do
        [ -n "$c" ] || continue
        case " $choices " in *" $c "*) printf '%s\n' "$c"; return 0 ;; esac
    done
    return 1
}

case "$cmd" in
on)
    mkdir -p "$STATE_DIR"
    : > "$STATE_FILE"

    [ -r "$PP" ] && printf 'PP=%s\n' "$(cat "$PP")" >> "$STATE_FILE"

    if [ -w "$PP" ]; then
        t=$(pick_platform_profile performance max-power balanced || true)
        [ -n "$t" ] && echo "$t" > "$PP" 2>/dev/null
    fi

    # Optional sched-ext scheduler (e.g. scx_lavd from the scx-scheds package).
    # Opt-in: set STARCH_SCX_SCHED in /etc/starch/profile.conf.
    SCX=""
    [ -r "$PROFILE_CONF" ] && SCX=$(. "$PROFILE_CONF" 2>/dev/null; echo "${STARCH_SCX_SCHED:-}")
    if [ -n "$SCX" ] && command -v "$SCX" >/dev/null 2>&1; then
        systemd-run --unit=starch-scx --quiet --collect "$(command -v "$SCX")" 2>/dev/null \
            || echo "starch-perf-mode: failed to start sched-ext scheduler $SCX" >&2
    fi
    ;;

off)
    PP_OLD=""
    if [ -r "$STATE_FILE" ]; then
        while IFS= read -r line; do
            case "$line" in
                PP=*) PP_OLD="${line#PP=}" ;;
            esac
        done < "$STATE_FILE"
    fi

    # Validate the snapshot against the firmware; if that profile is gone, fall
    # back to balanced rather than leaving the machine pinned to performance.
    if [ -w "$PP" ]; then
        t=$(pick_platform_profile "$PP_OLD" balanced low-power || true)
        [ -n "$t" ] && echo "$t" > "$PP" 2>/dev/null || true
    fi

    systemctl stop starch-scx.service 2>/dev/null || true

    rm -f "$STATE_FILE"
    ;;

*)
    echo "usage: $0 {on|off}" >&2
    exit 2
    ;;
esac
