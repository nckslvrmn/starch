#!/bin/bash
# Toggle session-scoped perf tweaks (replaces gamemode, whose X11-only GPU bits
# never worked under gamescope). `on` snapshots current values to
# /run/starch/perf.state and applies a preset sized to the power source — on AC
# the full performance pin (governor, EPP, platform_profile, NVIDIA
# persistence, optional sched-ext scheduler); on battery a balanced bias with
# the governor left alone. `off` restores from the snapshot, validating every
# value against what the hardware actually supports.

set -uo pipefail

STATE_DIR=/run/starch
STATE_FILE=$STATE_DIR/perf.state
PP=/sys/firmware/acpi/platform_profile
PROFILE_CONF=/etc/starch/profile.conf

cmd="${1:-}"

on_ac() {
    local psu found=0
    for psu in /sys/class/power_supply/*; do
        [ -r "$psu/type" ] || continue
        [ "$(cat "$psu/type")" = "Mains" ] || continue
        found=1
        [ "$(cat "$psu/online" 2>/dev/null)" = "1" ] && return 0
    done
    # No mains supply enumerated (desktop) — treat as AC.
    [ "$found" -eq 0 ]
}

# Echo the first requested governor this CPU actually supports. intel_pstate in
# active mode only offers performance/powersave — a blind schedutil write gets
# rejected and silently leaves the previous governor pinned.
pick_governor() {
    local avail="" g
    read -r avail < /sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors 2>/dev/null \
        || return 1
    for g in "$@"; do
        [ -n "$g" ] || continue
        case " $avail " in *" $g "*) printf '%s\n' "$g"; return 0 ;; esac
    done
    return 1
}

apply_governor() {
    local target="${1:-}" g
    [ -n "$target" ] || return 0
    for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do
        [ -w "$g" ] || continue
        echo "$target" > "$g" 2>/dev/null || true
    done
}

# intel_pstate EPP. Writes fail while the governor is pinned to performance
# (the kernel forces EPP=performance there) — harmless, hence the || true.
apply_epp() {
    local target="${1:-}" e
    [ -n "$target" ] || return 0
    for e in /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference; do
        [ -w "$e" ] || continue
        echo "$target" > "$e" 2>/dev/null || true
    done
}

pick_platform_profile() {
    local choices="" c
    read -r choices < "${PP}_choices" 2>/dev/null || return 1
    for c in "$@"; do
        case " $choices " in *" $c "*) printf '%s\n' "$c"; return 0 ;; esac
    done
    return 1
}

case "$cmd" in
on)
    mkdir -p "$STATE_DIR"
    : > "$STATE_FILE"

    g=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
    [ -r "$g" ] && printf 'GOV=%s\n' "$(cat "$g")" >> "$STATE_FILE"
    e=/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference
    [ -r "$e" ] && printf 'EPP=%s\n' "$(cat "$e")" >> "$STATE_FILE"
    [ -r "$PP" ] && printf 'PP=%s\n' "$(cat "$PP")" >> "$STATE_FILE"

    if on_ac; then
        apply_governor "$(pick_governor performance || true)"
        apply_epp performance
        if [ -w "$PP" ]; then
            t=$(pick_platform_profile performance || true)
            [ -n "$t" ] && echo "$t" > "$PP" 2>/dev/null
        fi
    else
        # On battery: bias instead of slam — EPP and platform_profile lean
        # toward performance, the governor keeps doing power-aware scaling.
        apply_epp balance_performance
        if [ -w "$PP" ]; then
            t=$(pick_platform_profile balanced-performance balanced || true)
            [ -n "$t" ] && echo "$t" > "$PP" 2>/dev/null
        fi
    fi

    if command -v nvidia-smi >/dev/null 2>&1; then
        nvidia-smi -pm 1 >/dev/null 2>&1 && printf 'NV=1\n' >> "$STATE_FILE"
    fi

    # Optional sched-ext scheduler (e.g. scx_lavd from the scx-scheds package).
    # Opt-in: set STARCH_SCX_SCHED in /etc/starch/profile.conf.
    SCX=""
    [ -r "$PROFILE_CONF" ] && SCX=$(. "$PROFILE_CONF" 2>/dev/null; echo "${STARCH_SCX_SCHED:-}")
    if [ -n "$SCX" ] && command -v "$SCX" >/dev/null 2>&1; then
        systemd-run --unit=starch-scx --quiet --collect "$(command -v "$SCX")" 2>/dev/null \
            || echo "starch-perf-mode: failed to start sched-ext scheduler $SCX" >&2
    fi
    ;;

off)
    GOV="" EPP_OLD="" PP_OLD=""
    if [ -r "$STATE_FILE" ]; then
        while IFS= read -r line; do
            case "$line" in
                GOV=*) GOV="${line#GOV=}" ;;
                EPP=*) EPP_OLD="${line#EPP=}" ;;
                PP=*)  PP_OLD="${line#PP=}" ;;
            esac
        done < "$STATE_FILE"
    fi

    # Validate the snapshot against the hardware; if it's gone, fall back
    # through whatever this CPU actually offers.
    apply_governor "$(pick_governor "$GOV" schedutil powersave || true)"
    apply_epp "${EPP_OLD:-balance_performance}"

    if [ -w "$PP" ] && [ -n "$PP_OLD" ]; then
        echo "$PP_OLD" > "$PP" 2>/dev/null || true
    fi

    if command -v nvidia-smi >/dev/null 2>&1; then
        nvidia-smi -pm 0 >/dev/null 2>&1 || true
    fi

    systemctl stop starch-scx.service 2>/dev/null || true

    rm -f "$STATE_FILE"
    ;;

*)
    echo "usage: $0 {on|off}" >&2
    exit 2
    ;;
esac
