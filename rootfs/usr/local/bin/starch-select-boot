#!/bin/bash
# Console mode: pick what the machine boots into. 'steam' writes a persistent
# SDDM autologin (lid open, controller in hand, no keyboard), 'greeter' restores
# the normal greeter. The root-side starch-session-handoff unit does the writing,
# so no sudo needed here.
#
# The persistent conf (20-starch-boot.conf) and the one-shot one
# (zz-starch-autologin.conf) coexist: the one-shot sorts later and wins for a
# single switch, then gets cleared and boots fall back to the persistent choice.
set -euo pipefail

BOOT_CONF=/etc/sddm.conf.d/20-starch-boot.conf

case "${1:-}" in
    steam|greeter)
        dir="${XDG_STATE_HOME:-$HOME/.local/state}/starch"
        mkdir -p "$dir"
        printf 'boot-%s\n' "$1" > "$dir/session-request"
        echo "starch: boot mode '$1' requested — takes effect next boot"
        ;;
    --show|-s)
        if [ -r "$BOOT_CONF" ]; then
            echo "boot mode: steam (autologin via $BOOT_CONF)"
        else
            echo "boot mode: greeter (default)"
        fi
        ;;
    *)
        echo "usage: starch-select-boot {steam|greeter|--show}" >&2
        echo "  steam    boot straight into the gamescope Steam session" >&2
        echo "  greeter  boot to the SDDM greeter (default)" >&2
        exit 2
        ;;
esac
