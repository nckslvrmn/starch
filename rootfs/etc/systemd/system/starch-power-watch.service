[Unit]
Description=starch power-profile watcher (FN+Q → CPU/GPU knobs)
Documentation=file:///usr/local/bin/starch-power-watch
# A system unit, not a user one: it writes /sys and has to survive session
# switches. Nothing here depends on a seat or a compositor.
After=multi-user.target
# power-profiles-daemon and tuned drive the same knobs, so running either
# alongside this means two writers fighting over EPP on every press.
Conflicts=power-profiles-daemon.service tuned.service

[Service]
Type=simple
ExecStart=/usr/local/bin/starch-power-watch
# The udevadm pipe is the only thing that can end this, so come back if it dies.
Restart=always
RestartSec=2
# It writes sysfs, so it needs root and nothing else.
#
# No PrivateNetwork=yes, on purpose. The kernel broadcasts uevents only to the
# initial network namespace, so a private netns leaves udevadm monitor sitting on
# a healthy netlink socket that never receives a single event: the service looks
# alive and silently never fires. AF_NETLINK stays in RestrictAddressFamilies for
# the same reason.
NoNewPrivileges=yes
ProtectHome=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
