# Watches for session-switch requests, written by steamos-session-select inside
# Steam's PID-namespaced, nosuid container (the filesystem is all it can reach)
# or by starch-session-request on the desktop side.
[Unit]
Description=Watch for starch session handoff requests

[Path]
PathChanged=@@GAMING_HOME@@/.local/state/starch/session-request
Unit=starch-session-handoff.service

[Install]
WantedBy=multi-user.target
