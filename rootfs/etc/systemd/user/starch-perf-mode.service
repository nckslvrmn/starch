[Unit]
Description=starch session performance preset
# A user unit, not a system one: systemd --user runs ExecStop when the session
# ends, so even a SIGKILLed compositor still gets the preset restored. A root
# unit would sit there RemainAfterExit with nobody left to stop it.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/sudo -n /usr/local/bin/starch-perf-mode on
ExecStop=/usr/bin/sudo -n /usr/local/bin/starch-perf-mode off
