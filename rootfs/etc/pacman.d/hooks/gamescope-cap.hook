# --rt and nice -20 are gated on CAP_SYS_NICE. Without it gamescope logs
# "Performance will be affected" and runs the compositor threads at normal
# priority. File caps are dropped on every package upgrade, so reapply it.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/bin/gamescope

[Action]
Description = Granting gamescope CAP_SYS_NICE (realtime scheduling for the Steam session)...
When = PostTransaction
Exec = /usr/bin/setcap cap_sys_nice=eip /usr/bin/gamescope
