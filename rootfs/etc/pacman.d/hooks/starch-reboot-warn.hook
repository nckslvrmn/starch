# The #1 rolling-release gaming breakage: kernel or NVIDIA userspace updated,
# modules for the *running* kernel are gone (or version-mismatched), and the
# next session start fails mysteriously. Make it loud instead.
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = linux
Target = linux-lts
Target = linux-zen
Target = nvidia
Target = nvidia-open
Target = nvidia-open-dkms
Target = nvidia-utils

[Action]
Description = starch: kernel/NVIDIA updated — REBOOT before gaming
When = PostTransaction
Exec = /usr/bin/bash -c 'printf "\033[1;33m[starch] Kernel or NVIDIA driver updated. REBOOT before starting a Steam/Desktop session:\n[starch] modules for the running kernel may be gone or version-mismatched until then.\033[0m\n"'
